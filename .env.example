# Copy thành .env rồi điền key. Không commit .env.
# Vector store Day 6 (PostgreSQL + pgvector chạy bằng docker compose của repo Day 6).
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Provider gọi model: openai (gọi thẳng api.openai.com) hoặc openrouter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Tên model chuẩn (có tiền tố, trùng cột embedding_model của index Day 6); client tự bỏ tiền tố khi gọi OpenAI.
EMBEDDING_MODEL=openai/text-embedding-3-small
AGENT_MODEL=openai/gpt-4o-mini
